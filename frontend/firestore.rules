rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Let anyone view stock data (READ ONLY)
    match /stock/{item} {
      allow read: if true;
      allow write: if false; 
    }
    match /restock_logs/{log} {
       allow read: if true;
       allow write: if false;
    }
    
    // 2. Intelligence Reports (READ ONLY)
    match /store_blogs/{blog} {
       allow read: if true;
       allow write: if false;
    }

    // 3. User alerts (Read/Create/Delete — needed for watch & unwatch)
    match /user_alerts/{alert} {
       allow read, create, delete: if true;
       allow update: if false;
    }

    // 4. User profiles (Needed for tiers)
    match /users/{userId} {
       allow read, write: if true;
    }
  }
}
